# Django Settings
DEBUG=False
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_SETTINGS_MODULE=gaayatri_project.settings

# Database (automatically set by Render when using PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Allowed Hosts and CSRF (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# Render automatically sets this
RENDER_EXTERNAL_HOSTNAME=your-app.onrender.com

# Chatbot / AI Settings (REQUIRED for chatbot functionality)
CHATBOT_API_KEY=your-groq-api-key-here
GROQ_API_KEY=your-groq-api-key-here
CHATBOT_MODEL=llama-3.1-8b-instant
CHATBOT_PROVIDER=groq
CHATBOT_EMBED_MODEL=all-MiniLM-L6-v2

# Optional: HuggingFace token for sentence transformers
HUGGINGFACE_API_TOKEN=your-huggingface-token-here

# Similarity threshold for chatbot
ALLOWED_SIMILARITY=0.65
